# ===== 服务端口 =====
PORT=3000
NODE_ENV=development

# ===== 数据库配置 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shop_agent_db
DB_USER=shop_user
DB_PASSWORD=Shop@123456
DB_POOL_MIN=5
DB_POOL_MAX=20

# ===== JWT 配置 =====
JWT_SECRET=please_change_this_secret
JWT_EXPIRES_IN=7d

# ===== LLM 配置 =====
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 限流 =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ===== Agent 运行时限制 =====
AGENT_MAX_ROUNDS=10
AGENT_TASK_TIMEOUT_MS=60000
AGENT_TOOL_TIMEOUT_MS=10000
